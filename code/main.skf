// ============================================
//   skf-currency — курсы валют ЦБ РФ
//   от SkyMonder
// ============================================

// Подтягиваем пакеты-помощники
пусть http = подтянуть "skf-http"
пусть json = подтянуть "skf-json"


// --------------------------------------------
//   КОНСТАНТЫ И КЭШ
// --------------------------------------------

пусть АДРЕС_ЦБ = "https://www.cbr-xml-daily.ru/daily_json.js"
пусть _кэш = ничего
пусть _время_кэша = 0


// --------------------------------------------
//   ВНУТРЕННИЕ ПОМОЩНИКИ
// --------------------------------------------

функция _сейчас() {
    // Текущий timestamp (локально, без зависимостей)
    подключить_питон("time")
    вернуть time.time()
}


// --------------------------------------------
//   ПОЛУЧЕНИЕ ДАННЫХ
// --------------------------------------------

функция _загрузить_данные() {
    // Загружает данные с ЦБ РФ. Кэширует на 1 час.
    пусть сейчас = _сейчас()
    
    если (_кэш != ничего и (сейчас - _время_кэша) < 3600) {
        вернуть _кэш
    }
    
    пусть ответ = http.получить(АДРЕС_ЦБ, ничего, ничего, 30)
    
    если (http.ок?(ответ) == ложь) {
        бросить "ЦБ РФ вернул код " + http.код(ответ)
    }
    
    // http.json() парсит тело ответа как JSON
    _кэш = http.json(ответ)
    _время_кэша = сейчас
    вернуть _кэш
}

функция курсы() {
    // Возвращает словарь всех валют: код → информация
    пусть данные = _загрузить_данные()
    вернуть данные["Valute"]
}

функция дата_курса() {
    // Дата, на которую актуальны курсы
    пусть данные = _загрузить_данные()
    вернуть данные["Date"]
}


// --------------------------------------------
//   КУРСЫ ОТДЕЛЬНЫХ ВАЛЮТ
// --------------------------------------------

функция курс(код_валюты) {
    // Курс валюты к рублю (с учётом номинала).
    // Пример: курс("USD") → 92.5 (сколько рублей за 1 доллар)
    пусть все = курсы()
    пусть код_верх = код_валюты.в_верхний()
    
    если (json.есть_ключ?(все, код_верх) == ложь) {
        бросить "Валюта не найдена: " + код_валюты
    }
    
    пусть валюта = все[код_верх]
    пусть номинал_валюты = валюта["Nominal"]
    пусть значение = валюта["Value"]
    
    // Приводим к курсу за 1 единицу валюты
    вернуть значение / номинал_валюты
}

функция курс_наоборот(код_валюты) {
    // Сколько единиц валюты за 1 рубль
    вернуть 1.0 / курс(код_валюты)
}

функция название(код_валюты) {
    // Название валюты на русском
    пусть все = курсы()
    пусть код_верх = код_валюты.в_верхний()
    
    если (json.есть_ключ?(все, код_верх) == ложь) {
        бросить "Валюта не найдена: " + код_валюты
    }
    
    вернуть все[код_верх]["Name"]
}

функция номинал(код_валюты) {
    // Номинал валюты (обычно 1, но для некоторых 10, 100 и т.д.)
    пусть все = курсы()
    пусть код_верх = код_валюты.в_верхний()
    
    если (json.есть_ключ?(все, код_верх) == ложь) {
        бросить "Валюта не найдена: " + код_валюты
    }
    
    вернуть все[код_верх]["Nominal"]
}

функция код_цифровой(код_валюты) {
    // Цифровой код валюты (например, USD → 840)
    пусть все = курсы()
    пусть код_верх = код_валюты.в_верхний()
    
    если (json.есть_ключ?(все, код_верх) == ложь) {
        бросить "Валюта не найдена: " + код_валюты
    }
    
    вернуть все[код_верх]["NumCode"]
}

функция предыдущий_курс(код_валюты) {
    // Предыдущее значение курса
    пусть все = курсы()
    пусть код_верх = код_валюты.в_верхний()
    
    если (json.есть_ключ?(все, код_верх) == ложь) {
        бросить "Валюта не найдена: " + код_валюты
    }
    
    пусть валюта = все[код_верх]
    вернуть валюта["Previous"] / валюта["Nominal"]
}

функция изменение(код_валюты) {
    // Изменение курса с предыдущего дня (в рублях)
    вернуть курс(код_валюты) - предыдущий_курс(код_валюты)
}

функция изменение_процент(код_валюты) {
    // Изменение курса в процентах
    пусть пред = предыдущий_курс(код_валюты)
    если (пред == 0) {
        вернуть 0
    }
    вернуть (изменение(код_валюты) / пред) * 100
}

функция растёт?(код_валюты) {
    // Вырос ли курс по сравнению с предыдущим днём
    вернуть изменение(код_валюты) > 0
}


// --------------------------------------------
//   КОНВЕРТАЦИЯ
// --------------------------------------------

функция конвертировать(сумма, из_валюты, в_валюту) {
    // Конвертирует сумму из одной валюты в другую через рубль.
    // Пример: конвертировать(100, "USD", "EUR")
    пусть из_код = из_валюты.в_верхний()
    пусть в_код = в_валюту.в_верхний()
    
    если (из_код == "RUB" и в_код == "RUB") {
        вернуть сумма
    }
    
    если (из_код == "RUB") {
        // Из рублей в валюту
        вернуть сумма / курс(в_код)
    }
    
    если (в_код == "RUB") {
        // Из валюты в рубли
        вернуть сумма * курс(из_код)
    }
    
    // Через рубль
    пусть в_рублях = сумма * курс(из_код)
    вернуть в_рублях / курс(в_код)
}

функция в_рубли(сумма, код_валюты) {
    // Быстрая конвертация в рубли
    вернуть конвертировать(сумма, код_валюты, "RUB")
}

функция из_рублей(сумма, код_валюты) {
    // Быстрая конвертация из рублей
    вернуть конвертировать(сумма, "RUB", код_валюты)
}


// --------------------------------------------
//   СПИСКИ ВАЛЮТ
// --------------------------------------------

функция все_коды() {
    // Список всех кодов валют
    вернуть json.ключи(курсы())
}

функция все_валюты() {
    // Список словарей с информацией о всех валютах
    пусть все = курсы()
    пусть результат = []
    
    для (код, данные в все.предметы()) {
        результат.добавить({
            "код": код,
            "название": данные["Name"],
            "курс": данные["Value"] / данные["Nominal"],
            "номинал": данные["Nominal"],
            "цифровой_код": данные["NumCode"]
        })
    }
    
    вернуть результат
}

функция топ_валют(количество) {
    // Топ валют по курсу (от самых дорогих)
    если (количество == ничего) {
        количество = 10
    }
    
    пусть список = все_валюты()
    пусть отсортированные = json.сортировать_по(список, "курс")
    
    // Реверсируем (от большего к меньшему)
    пусть результат = []
    пусть i = длина(отсортированные) - 1
    пока (i >= 0 и длина(результат) < количество) {
        результат.добавить(отсортированные[i])
        i = i - 1
    }
    
    вернуть результат
}

функция дешёвые_валюты(количество) {
    // Самые дешёвые валюты
    если (количество == ничего) {
        количество = 10
    }
    
    пусть список = все_валюты()
    пусть отсортированные = json.сортировать_по(список, "курс")
    
    пусть результат = []
    пусть i = 0
    пока (i < длина(отсортированные) и i < количество) {
        результат.добавить(отсортированные[i])
        i = i + 1
    }
    
    вернуть результат
}


// --------------------------------------------
//   ПОИСК И ФИЛЬТРАЦИЯ
// --------------------------------------------

функция найти_валюту(часть_названия) {
    // Ищет валюты по части названия (регистронезависимо)
    пусть список = все_валюты()
    пусть результат = []
    пусть часть_ниж = часть_названия.в_нижний()
    
    для (валюта в список) {
        если (валюта["название"].в_нижний().содержит(часть_ниж)) {
            результат.добавить(валюта)
        }
    }
    
    вернуть результат
}

функция валюты_дороже(порог) {
    // Валюты, курс которых выше указанного значения
    пусть список = все_валюты()
    пусть результат = []
    
    для (валюта в список) {
        если (валюта["курс"] > порог) {
            результат.добавить(валюта)
        }
    }
    
    вернуть результат
}

функция валюты_дешевле(порог) {
    // Валюты, курс которых ниже указанного значения
    пусть список = все_валюты()
    пусть результат = []
    
    для (валюта в список) {
        если (валюта["курс"] < порог) {
            результат.добавить(валюта)
        }
    }
    
    вернуть результат
}


// --------------------------------------------
//   ФОРМАТИРОВАНИЕ
// --------------------------------------------

функция форматировать_курс(код_валюты) {
    // Красивая строка: "USD: 92.50 ₽"
    пусть к = курс(код_валюты)
    вернуть код_валюты.в_верхний() + ": " + округлить(к, 2) + " ₽"
}

функция форматировать_конвертацию(сумма, из_валюты, в_валюту) {
    // Красивая строка конвертации
    пусть результат = конвертировать(сумма, из_валюты, в_валюту)
    вернуть округлить(сумма, 2) + " " + из_валюты.в_верхний() + " = " + округлить(результат, 2) + " " + в_валюту.в_верхний()
}

функция таблица_курсов(коды) {
    // Красивая таблица курсов для списка кодов
    пусть результат = "Код   | Название              | Курс (₽)\n"
    результат = результат + "------|----------------------|----------\n"
    
    для (код в коды) {
        пусть название_валюты = название(код)
        пусть курс_валюты = округлить(курс(код), 2)
        
        // Дополняем пробелами для выравнивания
        пусть код_стр = код.в_верхний()
        пока (длина(код_стр) < 5) {
            код_стр = код_стр + " "
        }
        
        пусть название_стр = название_валюты
        пока (длина(название_стр) < 20) {
            название_стр = название_стр + " "
        }
        
        результат = результат + код_стр + " | " + название_стр + " | " + курс_валюты + "\n"
    }
    
    вернуть результат
}


// --------------------------------------------
//   ОЧИСТКА КЭША
// --------------------------------------------

функция сбросить_кэш() {
    // Сбрасывает кэш, чтобы при следующем запросе данные загрузились заново
    _кэш = ничего
    _время_кэша = 0
}
